{
  "name": "project-lanes",
  "displayName": "Project Lanes - Fast Switching",
  "version": "0.1.13",
  "description": "Manage projects as lanes within a workspace and switch Explorer, terminals, and editor tabs in one click",
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YukiIto1999/vscode-project-lanes"
  },
  "publisher": "yukiito1999",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "vp build",
    "watch": "vp build --watch",
    "test": "vp test run",
    "test:e2e": "node --test test/e2e/scenarios.test.cjs && node test/e2e/run.cjs",
    "test:e2e:vsix": "node --test test/e2e/scenarios.test.cjs && node test/e2e/run-vsix.cjs",
    "test:release": "node --test test/release/*.test.cjs",
    "test:watch": "vp test",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "typecheck": "tsc --noEmit",
    "check": "vp check && npm run typecheck",
    "package": "vsce package",
    "verify:release": "node test/release/verify-release.cjs",
    "verify:vsix": "node test/release/verify-vsix.cjs",
    "checksum:vsix": "node test/release/checksum-vsix.cjs",
    "publish:vsix": "vsce publish"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.101.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "jszip": "3.10.1",
    "typescript": "^5.7.0",
    "vite-plus": "^0.1.24"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "project-lanes",
          "title": "Project Lanes",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "project-lanes": [
        {
          "id": "projectLanes",
          "name": "Lanes"
        }
      ]
    },
    "commands": [
      {
        "command": "projectLanes.initializeWorkspace",
        "title": "Initialize Workspace",
        "category": "Project Lanes"
      },
      {
        "command": "projectLanes.switchLane",
        "title": "Switch Lane",
        "category": "Project Lanes"
      },
      {
        "command": "projectLanes.closeTerminals",
        "title": "Close Terminals",
        "category": "Project Lanes"
      },
      {
        "command": "projectLanes.addFolder",
        "title": "Add Folder to Workspace",
        "category": "Project Lanes",
        "icon": "$(add)"
      },
      {
        "command": "projectLanes.reloadLanes",
        "title": "Reload Lanes",
        "category": "Project Lanes",
        "icon": "$(refresh)"
      },
      {
        "command": "projectLanes.locateFolder",
        "title": "Locate Folder",
        "category": "Project Lanes"
      },
      {
        "command": "projectLanes.renameLane",
        "title": "Rename Lane",
        "category": "Project Lanes"
      },
      {
        "command": "projectLanes.removeLane",
        "title": "Remove Lane",
        "category": "Project Lanes"
      },
      {
        "command": "projectLanes.toggleActivityIndicator",
        "title": "Toggle Activity Indicator",
        "category": "Project Lanes"
      },
      {
        "command": "projectLanes.findInLanes",
        "title": "Find in Lanes",
        "category": "Project Lanes"
      },
      {
        "command": "projectLanes.goToFileInLanes",
        "title": "Go to File in Lanes",
        "category": "Project Lanes"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "projectLanes.addFolder",
          "when": "view == projectLanes",
          "group": "navigation@1"
        },
        {
          "command": "projectLanes.reloadLanes",
          "when": "view == projectLanes",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "projectLanes.locateFolder",
          "when": "view == projectLanes && viewItem == projectLaneUnavailable",
          "group": "1_modify@1"
        },
        {
          "command": "projectLanes.renameLane",
          "when": "view == projectLanes && (viewItem == projectLaneAvailable || viewItem == projectLaneUnavailable)",
          "group": "1_modify@2"
        },
        {
          "command": "projectLanes.removeLane",
          "when": "view == projectLanes && (viewItem == projectLaneAvailable || viewItem == projectLaneUnavailable)",
          "group": "1_modify@3"
        }
      ]
    },
    "configuration": {
      "title": "Project Lanes",
      "properties": {
        "projectLanes.initializationMode": {
          "type": "string",
          "enum": [
            "manual",
            "automatic"
          ],
          "default": "manual",
          "scope": "window",
          "description": "Choose whether an unmanaged workspace is initialized only by command or automatically when Project Lanes starts."
        },
        "projectLanes.terminal.shellPath": {
          "type": "string",
          "default": "",
          "description": "Shell path for Lane Terminal. Leave empty to auto-detect from $SHELL."
        },
        "projectLanes.activity.showIndicator": {
          "type": "boolean",
          "default": true,
          "description": "Show running indicator in badge, decoration, and status bar when a lane has an executing terminal."
        }
      }
    },
    "terminal": {
      "profiles": [
        {
          "id": "projectLanes.terminal",
          "title": "Lane Terminal"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "projectLanes",
        "contents": "This extension requires a workspace file (.code-workspace).\n[Open Workspace File](command:workbench.action.openWorkspace)",
        "when": "workbenchState != workspace"
      },
      {
        "view": "projectLanes",
        "contents": "Initialize this workspace before Project Lanes changes its folders or settings.\n[Initialize Workspace](command:projectLanes.initializeWorkspace)",
        "when": "workbenchState == workspace && projectLanes.workspaceStatus =~ /^(unmanaged|recoverable)$/"
      },
      {
        "view": "projectLanes",
        "contents": "No lanes yet.\n[Add Folder to Workspace](command:projectLanes.addFolder)",
        "when": "workbenchState == workspace && projectLanes.workspaceStatus == ready"
      }
    ]
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.101.0"
  }
}
